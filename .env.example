# ==============================================================================
# TribIA — Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env (ou no PowerShell: Copy-Item .env.example .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IA — GOOGLE GEMINI (Classificação Fiscal e Sugestão de NCM)
# ------------------------------------------------------------------------------
# Chave da API do Google Gemini.
# Onde obter: https://aistudio.google.com/app/apikey
# Observação: Se deixada vazia, o backend inicia normalmente, utilizando respostas
# gravadas ou heurísticas de regras oficiais locais para classificação de itens.
GEMINI_API_KEY=sua-chave-gemini-aqui

# Modelos em ordem de preferência (se o primeiro falhar por cota/503, tenta o próximo):
TRIBIA_LLM_MODELOS=gemini-3.5-flash,gemini-3.5-flash-lite
tribia.llm.modelos=gemini-3.5-flash,gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. IA — JEV AI / TYPESAFE (Pontuação de Compatibilidade na Inteligência Fiscal)
# ------------------------------------------------------------------------------
# Modo de execução da JEV AI:
#   DESLIGADO -> Padrão seguro inicial: nenhuma chamada externa é realizada (sem custo).
#   HTTP      -> Conecta na API real da TypeSafe (COBRADO por token de entrada no /v1/systemone).
#                Ative SOMENTE após autorização explícita e com chave configurada.
#   SIMULADO  -> Gera notas fictícias locais (para testes de interface; bloqueado em profile prod).
TRIBIA_JEV_MODO=DESLIGADO
tribia.jev.modo=DESLIGADO

# Chave da API TypeSafe para o JEV AI.
# Onde obter: https://console.typesafe.ai/keys
JEV_API_KEY=sua-chave-typesafe-aqui
tribia.jev.api-key=sua-chave-typesafe-aqui

# Endpoint e modelo oficial da JEV AI:
TRIBIA_JEV_URL=https://api.typesafe.ai
tribia.jev.url=https://api.typesafe.ai
TRIBIA_JEV_MODELO=jev-1.13.0
tribia.jev.modelo=jev-1.13.0

# ------------------------------------------------------------------------------
# 3. ACESSO E AUTENTICAÇÃO LOCAL (ADMINISTRADOR)
# ------------------------------------------------------------------------------
# Credenciais do administrador local criadas ao iniciar a aplicação.
TRIBIA_ADMIN_NOME=Administrador
tribia.admin.nome=Administrador
TRIBIA_ADMIN_EMAIL=admin@tribia.local
tribia.admin.email=admin@tribia.local
TRIBIA_ADMIN_SENHA=troque-por-uma-senha-forte
tribia.admin.senha=troque-por-uma-senha-forte

# ------------------------------------------------------------------------------
# 4. BACKEND SPRING BOOT E BANCO DE DADOS LOCAL
# ------------------------------------------------------------------------------
SERVER_PORT=8090
server.port=8090

# Banco de dados H2 persistido em arquivo local (backend/data/tribia.mv.db):
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/tribia
spring.datasource.url=jdbc:h2:file:./data/tribia
SPRING_DATASOURCE_USERNAME=sa
spring.datasource.username=sa
SPRING_DATASOURCE_PASSWORD=
spring.datasource.password=

# Habilita console H2 em http://localhost:8090/h2-console
spring.h2.console.enabled=true

# ------------------------------------------------------------------------------
# 5. CALCULADORA OFICIAL DA REFORMA TRIBUTÁRIA (RTC / SERPRO - OPCIONAL)
# ------------------------------------------------------------------------------
# AUTO = tenta a oficial em :8080; se indisponível, faz fallback para cálculo simplificado.
# OFICIAL = exige a calculadora oficial no ar.
# SIMPLIFICADA = usa apenas motor local interno do TribIA.
TRIBIA_CALCULO_MODO=AUTO
tribia.calculo.modo=AUTO
TRIBIA_CALCULADORA_URL=http://localhost:8080/api
tribia.calculadora.url=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 6. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
# URL do backend consumida pelo proxy do Vite (porta 5173 -> 8090):
TRIBIA_BACKEND_URL=http://localhost:8090
# URL direta da API pelo navegador (vazio usa o proxy padrão do Vite):
VITE_API_URL=
