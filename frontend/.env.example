# Backend usado pelo proxy do Vite (npm run dev / npm run preview). Padrão: http://localhost:8090
TRIBIA_BACKEND_URL=http://localhost:8090

# URL base da API vista pelo navegador. Deixe vazio para usar o proxy do Vite (recomendado).
# Preencha só se o front for servido em outro lugar, ex.: VITE_API_URL=http://localhost:8090
VITE_API_URL=
